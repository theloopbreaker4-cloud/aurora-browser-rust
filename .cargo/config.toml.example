# Aurora Browser — machine-local build configuration
# Copy this file to .cargo/config.toml (it is gitignored).
# For WebView2-only builds this file is not needed at all.

[env]
# Prebuilt SpiderMonkey archive — skips ~30 min mozjs rebuild on subsequent builds.
# After first Servo build, find the hash and set the path:
#   dir /s /b vendor\servo\target\debug\build\mozjs_sys*\out\*.tar.gz
# Leave commented out on first build.
# MOZJS_ARCHIVE = { value = "C:\\path\\to\\AuroraBrowserRust\\vendor\\servo\\target\\debug\\build\\mozjs_sys-HASH\\out\\libmozjs-x86_64-pc-windows-msvc.tar.gz", force = false }

[patch."https://github.com/servo/stylo"]
selectors            = { path = "vendor/stylo/selectors" }
servo_arc            = { path = "vendor/stylo/servo_arc" }
stylo                = { path = "vendor/stylo/style" }
stylo_atoms          = { path = "vendor/stylo/stylo_atoms" }
stylo_dom            = { path = "vendor/stylo/stylo_dom" }
stylo_malloc_size_of = { path = "vendor/stylo/malloc_size_of" }
stylo_static_prefs   = { path = "vendor/stylo/stylo_static_prefs" }
stylo_traits         = { path = "vendor/stylo/style_traits" }
